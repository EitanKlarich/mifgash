# Google OAuth Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=

# Remote HTTPS backend base URL for Capacitor iOS/Android builds (leave blank for same-origin web)
VITE_API_URL=

# Optional public web origin for shareable group invite links in Capacitor builds (defaults to current origin on web)
VITE_PUBLIC_URL=

# Allowed frontend origin(s) for Express CORS (comma-separated for multiple domains)
FRONTEND_URL=
